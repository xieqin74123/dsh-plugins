{
  "name": "@local/dsh-python-env",
  "version": "0.1.0",
  "description": "Pick a conda or Python environment on the current DSH execution target (localhost or an SSH host) and make the Agent use it.",
  "author": "Qin Xie",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": "^0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-shell-env": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0",
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "python",
    "conda",
    "environment"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xieqin74123/dsh-plugins.git",
    "directory": "packages/dsh-python-env"
  },
  "bugs": {
    "url": "https://github.com/xieqin74123/dsh-plugins/issues"
  }
}
